# Copy this file to .env and fill in your values
# NEVER commit the real .env file to GitHub!

# ── Facebook ──────────────────────────────────────────────────────────────────
FB_PAGE_ID=YOUR_FACEBOOK_PAGE_NUMERIC_ID
FB_ACCESS_TOKEN=YOUR_FACEBOOK_PAGE_LONG_LIVED_ACCESS_TOKEN

# ── Instagram (Instagram Graph API — needs FB Business account linked) ─────────
IG_USER_ID=YOUR_INSTAGRAM_BUSINESS_ACCOUNT_ID
IG_ACCESS_TOKEN=YOUR_IG_ACCESS_TOKEN   # Usually same as FB_ACCESS_TOKEN

# ── Google Cloud Storage ──────────────────────────────────────────────────────
GCS_BUCKET_NAME=YOUR_GCS_BUCKET_NAME
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
